	override bool isDamageIgnored(name mod, int flags, int durThresh) {
		return super.isDamageIgnored(mod, flags, 2);
	}

	override Actor spawnBreakChunk(Vector3 pos, Vector3 vel, double scale) {
		let ppp = super.spawnBreakChunk(pos, vel, scale);
		ppp.setshade("#262626");

		return ppp;
	}

	override int,int,double,int,int,int,int,int HandleDamageType(
		name mod,
		int alv,
		actor inflictor,
		int damage,
		int armourdamage,
		double towound,
		int tobash,
		int toburn,
		int tostun,
		int tobreak,
		int resist
	) {
		switch(mod){
			case 'piercing':
				resist+=90*(alv+10);
				if(resist>0){
					damage-=resist;
					tobash=min(damage,resist)>>3;
				}
				armourdamage=random(0,damage>>2);
				break;
			case 'slashing':
				resist+=150+25*alv;
				if(resist>0){
					damage-=resist;
					tobash=min(damage,resist)>>2;
				}
				armourdamage=random(0,damage>>2);
				break;
			case 'teeth':
			case 'claws':
			case 'natural':
				resist+=random((alv<<4),15*alv);
				if(resist>0){
					damage-=resist;
					tobash=min(damage,resist)>>3;
				}
				armourdamage=random(0,damage>>3);
				break;
			default:
				return super.handleDamageType(mod, alv, inflictor, damage, armourdamage, towound, tobash, toburn, tostun, tobreak, resist);
		}

		return damage, armourdamage, towound, tobash, toburn, tostun, tobreak, resist;
	}

	override double onBulletHitLocation(int location, int crackseed, bool hashelmet) {
		double addpenshell=getBasePenShell();

		switch (location) {
			case ARMOUR_FACE:
			case ARMOUR_HEAD:
			case ARMOUR_ARMS:
			case ARMOUR_LEGS:
				//No head and leg armour
				addpenshell = -1;
				break;
			default:	//case ARMOUR_TORSO:
				//torso: just kinda uneven
				if(crackseed>max(durability,8))
					addpenshell*=frandom(0.95,1.1);
				break;
		}

		return addpenshell;
	}

	override double getBasePenShell() {
		return 30;
	}

	override void doDamageArmour(int armourdamage) {
		super.doDamageArmour(armourdamage);

		if (owner) owner.a_startsound("armor/plates/hit",29,CHANF_OVERLAP,1);
	}

	override int modifyArmourDamage(int armourdamage) {
		return armourdamage;
	}

	override void onDestroy() {
		super.onDestroy();

		if (owner) owner.a_startsound("armor/plates/break",30,CHANF_OVERLAP,1.0);
	}
}


//-------------------------------------------------
// Spawner
//-------------------------------------------------

class PB_ArmorPlate_MultipleDrops:IdleDummy{
	states{
	spawn:
		TNT1 A 0 nodelay{
				spawn("HDArmorPlate",pos,ALLOW_REPLACE);
				spawn("HDArmorPlate",pos+(1,2,1),ALLOW_REPLACE);
				spawn("HDArmorPlate",pos+(-2,-2,-1),ALLOW_REPLACE);
			}stop;
		}
	}