version "4.10"

//-------------------------------------------------
// Composite Armor Plate
//-------------------------------------------------

/*
A ballistic plate backed by both kevlar and ceramic that slots into most protective vests.

Stops most rounds (except for anything past 7.76mm) but struggles in durability 
due to it being made from a fragile material.

Since it slots into the torso, it won't protect you against headshots and leg shots.

*/

const DUR_ARMORPLATE=25;
const ENC_ARMORPLATE=115;
const STRIP_ARMORPLATE=STRIP_ARMOUR+20;
const HDLD_ARMORPLATE="cbp";

class HDArmorPlate : HDArmour {

	default {
		-HDPickup.DROPTRANSLATION
		+HDPickup.FITSINBACKPACK

		Tag "$TAG_ARMORPLATE";
		
		Inventory.icon "APL0A0";
		Inventory.pickupmessage "$PICKUP_ARMORPLATE";
		
		HDPickup.refid HDLD_ARMORPLATE;

		HDMagAmmo.maxperunit DUR_ARMORPLATE;
		HDMagAmmo.magbulk ENC_ARMORPLATE;
	}

	action void A_WearPlate(int delay = 50, int tostun = 10, bool blackout = false) {

		//Requires either a garrison or battle armor
		//TODO: Refactor into HDCINFO command list of allowed armors
		if(!(countinv('GarrisonArmourWorn') || countinv('BattleArmourWorn'))) {
			A_Log(StringTable.Localize("$ARMORPLATE_NOVEST"), true);
			return;
		}

		A_WearArmour(delay, tostun, blackout);
	}

	override void WearArmourHelpText(actor wearer,double durability) {
		if(!HDWeapon.CheckDoHelpText(wearer))return;
		wearer.A_Log(
			String.format(Stringtable.Localize("$ARMORPLATE_PUTON"), gettag())
			..Stringtable.Localize("$HD_SENTENCEBREAK")
			..Stringtable.Localize(GetArmourOpinion(durability/maxperunit))
		,true);
	}

	override string GetArmourOpinion(double qual) {
		if (qual < 0.1)  return "$ARMORPLATE_DURABILITY_1";
		if (qual < 0.3)  return "$ARMORPLATE_DURABILITY_3";
		if (qual < 0.6)  return "$ARMORPLATE_DURABILITY_6";
		if (qual < 0.75) return "$ARMORPLATE_DURABILITY_75";
		if (qual < 0.95) return "$ARMORPLATE_DURABILITY_95";
		return "$ARMORPLATE_DURABILITY_100";
	}

	override bool BeforePockets(actor other) {
		return other.findInventory(WornName()) && super.BeforePockets(other);
	}

	//modified to make removing your plate faster than
	//removing an armor vest
	override void onArmourChange(actor owner,int delay,int tostun,bool blackout) {
		HDArmour.ArmourChangeEffect(owner, delay * 0.5, tostun * 0.1, false);
	}

	states{
	spawn:
		APL0 ABC -1 nodelay{
			/*
				this doesn't work properly
			int amt=invoker.amount;
			if(amt>16)frame=0;
			else if(amt>9)frame=1;
			else if(amt>0)frame=2;
			
			*/
		}stop;
	use:
		TNT1 A 0 A_WearPlate();
		fail;
	}
}


class HDArmorPlateWorn : HDArmourWorn {
	default{
		Tag "$TAG_ARMORPLATE";

		HDPickup.bulk ENC_ARMORPLATE * 0.1;
		HDPickup.overlaypriority 15000;
		HDPickup.wornlayer STRIP_ARMORPLATE;

		HDArmourWorn.armoursprite "APL0A0";
		HDArmourWorn.armourback "APL0Z0";

		HDArmourWorn.durability DUR_ARMORPLATE;
		HDArmourWorn.hindrance 3.2;
		HDArmourWorn.thickness 3;
	}

	override void DrawHudStuff(
		hdstatusbar sb,
		hdplayerpawn hpl,
		int hdflags,
		int gzflags
	){
		vector2 coords=
			(hdflags&HDSB_AUTOMAP)?(4,86):
			(hdflags&HDSB_MUGSHOT)?((sb.hudlevel==1?-110:-55),-11):
			(0,-sb.mIndexFont.mFont.GetHeight()*2)
		;
		sb.drawbar(
			armoursprite,armourback,
			durability,default.durability,
			coords,-1,sb.SHADER_VERT,
			gzflags
		);
		sb.drawstring(
			sb.pnewsmallfont,sb.FormatNumber(durability),
			coords+(8,-7),gzflags|sb.DI_ITEM_CENTER|sb.DI_TEXT_ALIGN_RIGHT,
			Font.CR_DARKGRAY,scale:(0.5,0.5)
		);
	}

